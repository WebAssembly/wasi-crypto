package wasi:crypto@0.12.0;

/// Secrets management.
///
/// The secrets manager is used by the managed-key interfaces (`symmetric-managed`, `signatures-managed`, `kx-managed`) and by `external-secrets`.
///
/// The whole interface is optional.
///
/// __(optional)__
interface secrets-manager {
  use common.{crypto-errno, key-id, version};

  /// A set of options for a secrets manager.
  ///
  /// This is used to provide credentials, select a secrets store, or set any implementation-specific parameters.
  ///
  /// The set of supported options is defined by the host.
  resource secrets-manager-options {
    /// Create a new object to set non-default options.
    constructor();

    /// Set or update an option.
    ///
    /// This function may return `unsupported_option` if an option that doesn't exist for any implemented algorithms is specified.
    set: func(name: string, value: list<u8>) -> result<_, crypto-errno>;

    /// Set or update an integer option.
    ///
    /// This function may return `unsupported_option` if an option that doesn't exist for any implemented algorithms is specified.
    set-u64: func(name: string, value: u64) -> result<_, crypto-errno>;

    /// Set or update buffer that the host can use or return data into.
    ///
    /// NOTE: In WITX, this was a raw pointer into guest linear memory, ensuring the allocation counted against the guest's memory budget.
    /// This implementation using `list<u8>` does not have this guarantee and serves as a stopgap till [caller-supplied buffers](https://wasi.dev/roadmap) arrive in future WASI 0.3.x release.
    ///
    /// This function may return `unsupported_option` if an option that doesn't exist for any implemented algorithms is specified.
    @deprecated(version = 0.11.0)
    @since(version = 0.11.0)
    set-guest-buffer: func(name: string, buffer: list<u8>) -> result<_, crypto-errno>;
  }

  /// A handle to the optional secrets management facilities offered by a host.
  ///
  /// This is used to generate, retrieve and invalidate managed keys.
  resource secrets-manager {
    /// Create a context to use a secrets manager.
    ///
    /// The set of required and supported options is defined by the host.
    ///
    /// The function returns the `unsupported_feature` error code if secrets management facilities are not supported by the host.
    open: static func(options: option<borrow<secrets-manager-options>>) -> result<secrets-manager, crypto-errno>;

    /// Invalidate a managed key or key pair given an identifier and a version.
    ///
    /// This asks the secrets manager to delete or revoke a stored key, a specific version of a key.
    ///
    /// `key_version` can be set to a version number, to `version.latest` to invalidate the current version, or to `version.all` to invalidate all versions of a key.
    ///
    /// The function returns `unsupported_feature` if this operation is not supported by the host, and `not_found` if the identifier and version don't match any existing key.
    invalidate: func(key-id: key-id, key-version: version) -> result<_, crypto-errno>;
  }
}
